{
  "name": "personal-agents",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p apps/desktop --noEmit && tsc -p packages/host --noEmit",
